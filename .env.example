# Bootstrap defaults for the notification channels. Copy to .env and fill in
# what you need - docker compose picks .env up automatically:
#
#   cp .env.example .env
#
# Everything here is optional, and whatever you save in the dashboard's
# Notifications panel overrides it field by field. Leave a line blank or
# commented out to leave that setting to the dashboard.

# --- Push / webhook --------------------------------------------------------
# NTFY_URL=https://ntfy.sh/your-unguessable-topic-name
# WEBHOOK_URL=https://example.com/hook

# --- Email -----------------------------------------------------------------
# Pick one provider: "resend" (HTTP API) or "smtp". Blank means no email.
# EMAIL_PROVIDER=resend
# EMAIL_FROM=alerts@example.com
# EMAIL_FROM_NAME=Streammonitor Alerts
# EMAIL_TO=ops@example.com,oncall@example.com

# Only for EMAIL_PROVIDER=resend. The sending domain must be verified in
# Resend, or use onboarding@resend.dev as EMAIL_FROM while testing.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Only for EMAIL_PROVIDER=smtp. SMTP_PORT defaults to 587 (STARTTLS);
# SMTP_SECURE=true means implicit TLS and defaults to on for port 465.
# Leave SMTP_USER/SMTP_PASS out for a relay that doesn't want auth.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=streammonitor@example.com
# SMTP_PASS=
